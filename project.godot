"01_loop4_d0_final": "res://dialogic/timelines/04_final_loop/01_loop4_d0_final.dtl",
"01_prologue_main": "res://dialogic/timelines/00_prologue/01_prologue_main.dtl",
"02_loop1_a1_fire": "res://dialogic/timelines/01_loop_1/02_loop1_a1_fire.dtl",
"02_loop2_b1_puppet": "res://dialogic/timelines/02_loop_2/02_loop2_b1_puppet.dtl",
"02_loop3_c1_warning": "res://dialogic/timelines/03_loop_3/02_loop3_c1_warning.dtl",
"02_prologue_assassination": "res://dialogic/timelines/00_prologue/02_prologue_assassination.dtl",
"03_loop1_a2_throne": "res://dialogic/timelines/01_loop_1/03_loop1_a2_throne.dtl",
"03_loop2_b2_abyss": "res://dialogic/timelines/02_loop_2/03_loop2_b2_abyss.dtl",
"03_loop3_c2_king": "res://dialogic/timelines/03_loop_3/03_loop3_c2_king.dtl",
"03_prologue_death": "res://dialogic/timelines/00_prologue/03_prologue_death.dtl"
}
layout/style_directory={
"": "res://dialogic/styles/custom_vn_style.tres",
"Custom VN Style": "res://dialogic/styles/custom_vn_style.tres",
"Visual Novel Style": "res://addons/dialogic/Modules/DefaultLayoutParts/Style_VN_Default/default_vn_style.tres"
}
layout/default_style="res://dialogic/styles/custom_vn_style.tres"
layout/style_list=["res://dialogic/styles/custom_vn_style.tres", "res://addons/dialogic/Modules/DefaultLayoutParts/Style_VN_Default/default_vn_style.tres"]
variables={
"option_explored:a_v0_chancellor": false,
"option_explored:a_v0_cyras": false,
"option_explored:a_v0_king": false,
"option_explored:a_v1_chancellor": false,
"option_explored:a_v1_cyras": false,
"option_explored:a_v1_king": false,
"option_explored:a_v2_chancellor": false,
"option_explored:a_v2_cyras": false,
"option_explored:a_v2_king": false,
"option_explored:final_rush_arrest": false
}
audio/channel_defaults={
"": {
"audio_bus": "SFX",
"fade_length": 0.0,
"loop": false,
"volume": 0.0
},
"music": {
"audio_bus": "BGM",
"fade_length": 0.0,
"loop": true,
"volume": 0.0
}
}
audio/type_sound_bus="SFX"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="無知的死刑"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg")

